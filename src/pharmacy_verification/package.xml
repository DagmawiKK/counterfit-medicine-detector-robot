<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pharmacy_verification</name>
  <version>0.0.1</version>
  <description>Pharmacy Counterfeit Detection System (PCDS) verification package</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>gz_ros2_control</depend>
  <depend>geometry_msgs</depend>
  <depend>ros_gz_interfaces</depend>
  
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  
  <!-- Vision and OCR dependencies -->
  <!-- Note: zbar_ros and tesseract_ros might need to be built from source or installed via apt if available in humble -->
  <depend>zbar_ros</depend> 
  <!-- <depend>tesseract_ros</depend>  Keeping commented as it's complex to install, usually requires tesseract_ocr system pkg -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
