<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="medicine_bottle">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0001</iyy> <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 1. Main Bottle Body (Brown Glass) -->
      <visual name="body_visual">
        <pose>0 0 -0.015 0 0 0</pose> <!-- Shifted down to make room for neck -->
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.2 0.05 1</ambient>
          <diffuse>0.4 0.2 0.05 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
          <pbr>
            <metal>
              <roughness>0.1</roughness>
              <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 2. Bottle Shoulder (Sphere/Cylinder transition) -->
      <visual name="shoulder_visual">
        <pose>0 0 0.02 0 0 0</pose> 
        <geometry>
            <sphere>
                <radius>0.0295</radius>
            </sphere>
        </geometry>
        <material>
          <ambient>0.4 0.2 0.05 1</ambient>
          <diffuse>0.4 0.2 0.05 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
          <pbr>
            <metal>
              <roughness>0.1</roughness>
              <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 3. Needle/Neck -->
      <visual name="neck_visual">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.2 0.05 1</ambient>
          <diffuse>0.4 0.2 0.05 1</diffuse>
           <specular>0.8 0.8 0.8 1</specular>
           <pbr>
            <metal>
              <roughness>0.1</roughness>
              <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- 4. Label (High Res Texture) -->
      <visual name="label_visual">
        <pose>0 0 -0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0305</radius>
            <length>0.055</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://medicine_bottle/materials/textures/label_variant_5.png</albedo_map>
              <roughness>0.7</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      
      <!-- 5. Cap (White ribbed plastic) -->
      <visual name="cap_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
