        </visual>
        <collision name="collision">
             <geometry><box><size>3 0.5 2</size></box></geometry>
        </collision>
      </link>
    </model>
    
    <!-- Use a Fuel Model for Back Shelf -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bookshelf</uri>
      <name>shelf_back</name>
      <pose>2.5 0 0 0 0 1.57</pose>
    </include>

    <!-- Potted Plant (Simulated) -->
    <model name="potted_plant_1">
       <static>true</static>
       <pose>1.5 1.0 0 0 0 0</pose>
       <link name="link">
         <visual name="pot">
            <geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
            <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
