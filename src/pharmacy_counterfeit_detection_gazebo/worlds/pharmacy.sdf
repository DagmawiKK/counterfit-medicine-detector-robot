<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="pharmacy_world">
    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <!-- Essential system plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <!-- Sensors plugin for the camera -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting: Indoor Pharmacy Lighting -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.9 0.9 0.9 1.0</background>
      <grid>false</grid>
    </scene>

    <!-- Main overhead light -->
    <light type="point" name="ceiling_light_1">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.2</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Fill light -->
    <light type="point" name="ceiling_light_2">
      <pose>2 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.2</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Ground Plane (Glossy Tile Floor) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.9 0.93 0.95 1</ambient>
            <diffuse>0.9 0.93 0.95 1</diffuse>
            <specular>0.7 0.7 0.7 1</specular>
            <pbr>
              <metal>
                <roughness>0.2</roughness> <!-- Slightly glossy -->
                <metalness>0.1</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Moving Belt: Top run (visible) -->
    <model name="moving_belt_A">
      <static>false</static>
      <pose>0 0 0.815 0 0 0</pose>
      <link name="belt_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.44 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
            <pbr>
              <metal>
                <roughness>0.7</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 0.44 0.004</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>100</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
      <plugin
        filename="ignition-gazebo-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>

    <model name="moving_belt_B">
      <static>false</static>
      <pose>2.01 0 0.815 0 0 0</pose>
      <link name="belt_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.44 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
            <pbr>
              <metal>
                <roughness>0.7</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 0.44 0.004</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>100</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
      <plugin
        filename="ignition-gazebo-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>

    <!-- Moving Belt: Return run (hidden under table, opposite direction) -->
    <model name="moving_belt_A_return">
      <static>false</static>
      <pose>-2.01 0 0.68 0 0 0</pose>
      <link name="belt_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.44 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
            <pbr>
              <metal>
                <roughness>0.7</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 0.44 0.004</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>100</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
      <plugin
        filename="ignition-gazebo-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>

    <model name="moving_belt_B_return">
      <static>false</static>
      <pose>0 0 0.68 0 0 0</pose>
      <link name="belt_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.44 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
            <pbr>
              <metal>
                <roughness>0.7</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 0.44 0.004</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>100</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
      <plugin
        filename="ignition-gazebo-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>

    <!-- Detailed Conveyor Belt -->
    <model name="conveyor_belt">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      
      <!-- 1. Support Structure (Legs and Frame) -->
      <link name="support_structure">
        <!-- Vertical Legs (Cylindrical Silver Aluminum) -->
        <visual name="leg_1">
          <pose>0.8 0.2 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
        </visual>
        <visual name="leg_2">
          <pose>0.8 -0.2 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
        </visual>
        <visual name="leg_3">
          <pose>-0.8 0.2 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
        </visual>
        <visual name="leg_4">
          <pose>-0.8 -0.2 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
        </visual>

        <!-- Adjustable Feet -->
        <visual name="foot_1"><pose>0.8 0.2 0.015 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="foot_2"><pose>0.8 -0.2 0.015 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="foot_3"><pose>-0.8 0.2 0.015 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="foot_4"><pose>-0.8 -0.2 0.015 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>

        <!-- Rollers at ends -->
        <visual name="roller_front">
            <pose>1.5 0 0.71 1.57 0 0</pose>
            <geometry><cylinder><radius>0.105</radius><length>0.44</length></cylinder></geometry>
            <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        <visual name="roller_back">
            <pose>-1.5 0 0.71 1.57 0 0</pose>
            <geometry><cylinder><radius>0.105</radius><length>0.44</length></cylinder></geometry>
            <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>

        <!-- Horizontal Lower Crossbeams -->
        <visual name="crossbeam_front">
            <pose>0.8 0 0.2 1.57 0 0</pose>
            <geometry><cylinder><radius>0.015</radius><length>0.4</length></cylinder></geometry>
            <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
        <visual name="crossbeam_back">
            <pose>-0.8 0 0.2 1.57 0 0</pose>
            <geometry><cylinder><radius>0.015</radius><length>0.4</length></cylinder></geometry>
             <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
        <visual name="crossbeam_long">
            <pose>0 0 0.2 0 1.57 0</pose>
            <geometry><cylinder><radius>0.015</radius><length>1.6</length></cylinder></geometry>
             <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>

      </link>

      <!-- 2. Main Conveyor Frame (Industrial Look) -->
      <link name="frame">
        <pose>0 0 0.75 0 0 0</pose>
        
        <!-- Main Chassis Block (Black Metal) -->
        <visual name="chassis">
           <geometry><box><size>2.0 0.45 0.12</size></box></geometry>
           <material>
             <ambient>0.15 0.15 0.15 1</ambient>
             <diffuse>0.15 0.15 0.15 1</diffuse>
             <specular>0.3 0.3 0.3 1</specular>
             <pbr><metal><roughness>0.4</roughness><metalness>0.2</metalness></metal></pbr>
           </material>
        </visual>
        
        <!-- Cyan/Blue Side Bumpers/Rails -->
        <visual name="rail_left">
           <pose>0 0.235 0 0 0 0</pose>
           <geometry><box><size>2.0 0.02 0.12</size></box></geometry>
           <material>
             <ambient>0.0 0.6 0.8 1</ambient>
             <diffuse>0.0 0.6 0.8 1</diffuse>
             <specular>0.5 0.5 0.5 1</specular>
             <pbr><metal><roughness>0.3</roughness><metalness>0.0</metalness></metal></pbr>
           </material>
        </visual>
        <visual name="rail_right">
           <pose>0 -0.235 0 0 0 0</pose>
           <geometry><box><size>2.0 0.02 0.12</size></box></geometry>
            <material>
             <ambient>0.0 0.6 0.8 1</ambient>
             <diffuse>0.0 0.6 0.8 1</diffuse>
             <specular>0.5 0.5 0.5 1</specular>
             <pbr><metal><roughness>0.3</roughness><metalness>0.0</metalness></metal></pbr>
           </material>
        </visual>

        <!-- End Rollers (Visual) -->
        <visual name="roller_front">
           <pose>1.0 0 0 1.57 0 0</pose>
           <geometry><cylinder><radius>0.05</radius><length>0.45</length></cylinder></geometry>
           <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        <visual name="roller_back">
           <pose>-1.0 0 0 1.57 0 0</pose>
           <geometry><cylinder><radius>0.05</radius><length>0.45</length></cylinder></geometry>
            <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        
        <!-- Bolts/Rivets Series on Side (Visual Detail) -->
        <visual name="bolt_1"><pose>0.8 0.25 0 0 1.57 0</pose><geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
        <visual name="bolt_2"><pose>0.4 0.25 0 0 1.57 0</pose><geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
        <visual name="bolt_3"><pose>0.0 0.25 0 0 1.57 0</pose><geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
        <visual name="bolt_4"><pose>-0.4 0.25 0 0 1.57 0</pose><geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
        <visual name="bolt_5"><pose>-0.8 0.25 0 0 1.57 0</pose><geometry><cylinder><radius>0.005</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>

        <collision name="collision_chassis">
           <geometry><box><size>2.0 0.5 0.12</size></box></geometry>
        </collision>
      </link>

      <!-- 3. Motor Housing -->
      <link name="motor_housing">
        <pose>-0.8 0.3 0.75 0 0 0</pose>
        <visual name="motor_box">
            <geometry><box><size>0.2 0.15 0.15</size></box></geometry>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
                <specular>0.8 0.8 0.8 1</specular>
            </material>
        </visual>
        <visual name="motor_cylinder">
             <pose>0 -0.1 0 1.57 0 0</pose>
             <geometry><cylinder><radius>0.05</radius><length>0.1</length></cylinder></geometry>
             <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
      </link>

      <!-- 4. Belt Surface is now a separate moving model (see below) -->
    </model>

    <!-- Camera Stand System -->
    <model name="camera_stand">
        <static>true</static>
        <pose>0 -0.6 0 0 0 0</pose> 
        
        <link name="stand_structure">
            <!-- 1. Aluminum Profile Post (Silver/Grey) -->
            <visual name="post">
                <pose>0 0 0.7 0 0 0</pose>
                <geometry><box><size>0.06 0.06 1.4</size></box></geometry>
                <material>
                    <ambient>0.7 0.7 0.75 1</ambient>
                    <diffuse>0.7 0.7 0.75 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                    <pbr><metal><roughness>0.3</roughness><metalness>0.6</metalness></metal></pbr>
                </material>
            </visual>
            
            <!-- 2. Heavy Base Plate (Dark Grey Steel) -->
            <visual name="base_plate">
                <pose>0 0 0.01 0 0 0</pose>
                <geometry><box><size>0.25 0.25 0.02</size></box></geometry>
                <material>
                    <ambient>0.2 0.2 0.22 1</ambient>
                    <diffuse>0.2 0.2 0.22 1</diffuse>
                </material>
            </visual>
            
            <!-- 3. Horizontal Arm (Aluminum Profile) -->
            <visual name="arm">
                <pose>0 0.35 1.37 0 0 0</pose> 
                <geometry><box><size>0.04 0.76 0.04</size></box></geometry>
                <material>
                    <ambient>0.7 0.7 0.75 1</ambient>
                    <diffuse>0.7 0.7 0.75 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                    <pbr><metal><roughness>0.3</roughness><metalness>0.6</metalness></metal></pbr>
                </material>
            </visual>
            
            <!-- 4. Corner Bracket (Connector) -->
            <visual name="corner_bracket">
                <pose>0 0.04 1.34 0 0 0</pose>
                <geometry><box><size>0.06 0.08 0.06</size></box></geometry>
                <material><ambient>0.1 0.1 0.1 1</ambient></material>
            </visual>
            
            <!-- 5. Camera Mount Mechanism -->
            <visual name="mount_mechanism">
                <pose>0 0.6 1.35 0 0 0</pose>
                <geometry><box><size>0.05 0.06 0.05</size></box></geometry>
                <material><ambient>0.1 0.1 0.1 1</ambient></material>
            </visual>
            
            <!-- 6. Camera Drop Rod -->
            <visual name="drop_rod">
                <pose>0 0.6 1.25 0 0 0</pose> 
                <geometry><cylinder><radius>0.008</radius><length>0.15</length></cylinder></geometry>
                <material>
                    <ambient>0.9 0.9 0.9 1</ambient> <!-- Chrome/Steel -->
                    <diffuse>0.9 0.9 0.9 1</diffuse>
                    <pbr><metal><roughness>0.1</roughness><metalness>1.0</metalness></metal></pbr>
                </material>
            </visual>

            <!-- Detailed Camera Model -->
            <!-- Main Body: Basler/Cognex Style (Blue/Black cube) -->
            <visual name="cam_body_main">
                <pose>0 0.6 1.15 0 0 0</pose> <!-- World Z ~ 1.15m -->
                <geometry><box><size>0.06 0.06 0.08</size></box></geometry> <!-- Vertical box -->
                <material>
                    <ambient>0.1 0.15 0.3 1</ambient> <!-- Dark Blue -->
                    <diffuse>0.1 0.15 0.3 1</diffuse> 
                    <specular>0.4 0.4 0.4 1</specular>
                </material>
            </visual>
            
            <!-- Top Cap (Connectors) -->
            <visual name="cam_cap">
                <pose>0 0.6 1.19 0 0 0</pose>
                <geometry><box><size>0.058 0.058 0.005</size></box></geometry>
                <material><ambient>0.1 0.1 0.1 1</ambient></material>
            </visual>
            
            <!-- Lens Barrel (Black metal) -->
            <visual name="cam_lens_barrel">
                <pose>0 0.6 1.10 0 0 0</pose> <!-- Below body -->
                <geometry><cylinder><radius>0.02</radius><length>0.04</length></cylinder></geometry>
                <material><ambient>0.05 0.05 0.05 1</ambient></material>
            </visual>
            
            <!-- Glass Lens Element (Reflective) -->
             <visual name="cam_lens_glass">
                <pose>0 0.6 1.081 0 0 0</pose>
                <geometry><cylinder><radius>0.015</radius><length>0.002</length></cylinder></geometry>
                <material>
                    <ambient>0.0 0.0 0.2 0.8</ambient>
                    <diffuse>0.0 0.0 0.2 0.8</diffuse>
                    <specular>0.9 0.9 0.9 1</specular>
                    <emissive>0 0 0 1</emissive>
                </material>
            </visual>

            <!-- Ring Light (LED Illuminator) -->
            <visual name="ring_light_housing">
                <pose>0 0.6 1.09 0 0 0</pose>
                <geometry><cylinder><radius>0.04</radius><length>0.015</length></cylinder></geometry>
                <material><ambient>0.2 0.2 0.2 1</ambient></material>
            </visual>
            <visual name="ring_light_face">
                <pose>0 0.6 1.083 0 0 0</pose>
                <geometry><cylinder><radius>0.035</radius><length>0.002</length></cylinder></geometry>
                <material>
                    <ambient>0.9 0.9 1.0 1</ambient> <!-- Bluish white LED -->
                    <emissive>0.5 0.5 0.6 1</emissive> <!-- Glows slightly -->
                </material>
            </visual>
            
            <!-- Data Cable (Yellow Ethernet) -->
             <visual name="cable">
                <pose>0 0.66 1.25 0.5 0 0</pose> <!-- Curving out back/top -->
                <geometry><cylinder><radius>0.003</radius><length>0.2</length></cylinder></geometry>
                <material><ambient>0.8 0.7 0.0 1</ambient></material>
            </visual>

            <!-- THE SENSOR -->
            <sensor name="camera" type="camera">
              <pose>0 0.6 1.20 0 0.9 1.5708</pose> <!-- Angled toward bottle side label -->
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>10</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>camera/image_raw</topic>
            </sensor>
        </link>
    </model>

    <!-- Medicine Bottle on Conveyor -->
    <include>
      <uri>model://medicine_bottle</uri>
      <name>medicine_bottle</name>
      <pose>0.5 0 0.85 0 0 0</pose>
    </include>

    <!-- Detailed Pharmacy Shelf 1 (Left) -->
    <model name="shelf_left">
      <static>true</static>
      <pose>0 1.5 0 0 0 0</pose>
      <link name="link">
        <!-- Main Structure (White) -->
        <visual name="back">
           <pose>0 0.24 1.0 0 0 0</pose> <geometry><box><size>3 0.02 2</size></box></geometry>
           <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="side1">
           <pose>1.49 0 1.0 0 0 0</pose> <geometry><box><size>0.02 0.5 2</size></box></geometry>
           <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="side2">
           <pose>-1.49 0 1.0 0 0 0</pose> <geometry><box><size>0.02 0.5 2</size></box></geometry>
           <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <!-- Shelves -->
        <visual name="shelf1"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>3 0.5 0.02</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
        <visual name="shelf2"><pose>0 0 1.0 0 0 0</pose><geometry><box><size>3 0.5 0.02</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
        <visual name="shelf3"><pose>0 0 1.5 0 0 0</pose><geometry><box><size>3 0.5 0.02</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
        <visual name="shelf4"><pose>0 0 0.1 0 0 0</pose><geometry><box><size>3 0.5 0.1</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual> <!-- Base kicker -->

        <!-- Stocked Items (Visual Blocks) -->
        <visual name="items_row1">
            <pose>0 -0.1 1.6 0 0 0</pose>
            <geometry><box><size>2.8 0.2 0.15</size></box></geometry>
            <material><ambient>0.2 0.6 0.2 1</ambient><diffuse>0.2 0.6 0.2 1</diffuse></material>
        </visual>
        <visual name="items_row2">
            <pose>0.5 -0.1 1.1 0 0 0</pose>
            <geometry><box><size>1.0 0.2 0.15</size></box></geometry>
            <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
         <visual name="items_row3">
            <pose>-0.5 -0.1 1.1 0 0 0</pose>
            <geometry><box><size>1.0 0.2 0.15</size></box></geometry>
            <material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material>
        </visual>
        
        <collision name="collision">
             <geometry><box><size>3 0.5 2</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Shelf Right (Mirror) -->
    <model name="shelf_right">
      <static>true</static>
      <pose>0 -1.5 0 0 0 3.1415</pose>
      <link name="link">
        <visual name="back">
           <pose>0 0.24 1.0 0 0 0</pose> <geometry><box><size>3 0.02 2</size></box></geometry>
           <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="side1">
           <pose>1.49 0 1.0 0 0 0</pose> <geometry><box><size>0.02 0.5 2</size></box></geometry>
           <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="side2">
           <pose>-1.49 0 1.0 0 0 0</pose> <geometry><box><size>0.02 0.5 2</size></box></geometry>
           <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="shelf1"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>3 0.5 0.02</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
        <visual name="shelf2"><pose>0 0 1.0 0 0 0</pose><geometry><box><size>3 0.5 0.02</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
        <visual name="shelf3"><pose>0 0 1.5 0 0 0</pose><geometry><box><size>3 0.5 0.02</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
        <visual name="shelf4"><pose>0 0 0.1 0 0 0</pose><geometry><box><size>3 0.5 0.1</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>

        <visual name="items_row1">
            <pose>0 -0.1 0.6 0 0 0</pose>
            <geometry><box><size>2.5 0.2 0.12</size></box></geometry>
            <material><ambient>0.9 0.9 0.2 1</ambient><diffuse>0.9 0.9 0.2 1</diffuse></material>
        </visual>
        <visual name="items_row2">
            <pose>0.8 -0.1 1.1 0 0 0</pose>
