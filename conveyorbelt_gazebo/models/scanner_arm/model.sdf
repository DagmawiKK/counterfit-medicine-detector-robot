<?xml version="1.0"?>
<!--
  Scanner arm model (SDF) for Gazebo Classic.
  - Vertical pole with horizontal extension.
  - Downward-facing camera sensor.
  - Static model.
-->
<sdf version="1.6">
  <model name="scanner_arm">
    <static>true</static>

    <link name="base_plate">
      <pose>0 0 0.01 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.55 0.57 0.60 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <albedo>0.55 0.57 0.60 1</albedo>
              <metalness>1.0</metalness>
              <roughness>0.2</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Decorative flange ring + bolts (visual only) -->
      <visual name="base_ring_visual">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      <visual name="bolt_1">
        <pose>0.06 0.06 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="bolt_2">
        <pose>-0.06 0.06 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="bolt_3">
        <pose>-0.06 -0.06 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="bolt_4">
        <pose>0.06 -0.06 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="pole_link">
      <pose>0 0 0.62 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.10</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.10</iyy>
          <iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <collision name="pole_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>1.20</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pole_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>1.20</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.55 0.57 0.60 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <albedo>0.55 0.57 0.60 1</albedo>
              <metalness>1.0</metalness>
              <roughness>0.2</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Simple collar and top cap (visual only) -->
      <visual name="pole_collar">
        <pose>0 0 -0.55 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      <visual name="pole_cap">
        <pose>0 0 0.60 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.032</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="arm_link">
      <pose>0.25 0 1.22 0 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.05</iyy>
          <iyz>0</iyz>
          <izz>0.05</izz>
        </inertia>
      </inertial>
      <collision name="arm_collision">
        <geometry>
          <box>
            <size>0.50 0.05 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="arm_visual">
        <geometry>
          <box>
            <size>0.50 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.55 0.57 0.60 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <albedo>0.55 0.57 0.60 1</albedo>
              <metalness>1.0</metalness>
              <roughness>0.2</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Rounded end-caps + cable conduit (visual only) -->
      <visual name="arm_endcap_left">
        <pose>-0.25 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
        </material>
      </visual>
      <visual name="arm_endcap_right">
        <pose>0.25 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
        </material>
      </visual>
      <visual name="arm_conduit">
        <pose>0 0.032 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.45</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="camera_link">
      <pose>0.50 0 1.22 3 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.06 0.04 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.06 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Camera styling: bezel + lens + status LED (visual only) -->
      <visual name="camera_bezel">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.065 0.045 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <visual name="camera_lens">
        <pose>0 0 -0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>
      <visual name="camera_led">
        <pose>0.02 0.015 -0.01 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.004</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.1 0.8 0.2 1</ambient>
          <diffuse>0.1 0.8 0.2 1</diffuse>
        </material>
      </visual>

      <sensor name="scanner_camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
        <!-- Sensor pose (xyz rpy). Pitch -90deg to look down; roll set to 3 rad as requested. -->
        <pose>0 0 -0.025 3 -1.5708 0</pose>
        <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera</namespace>
          </ros>
          <cameraName>scanner_camera</cameraName>
          <imageTopicName>raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>camera_link</frameName>
          <updateRate>30.0</updateRate>
        </plugin>
      </sensor>
    </link>

    <joint name="base_to_pole" type="fixed">
      <parent>base_plate</parent>
      <child>pole_link</child>
    </joint>

    <joint name="pole_to_arm" type="fixed">
      <parent>pole_link</parent>
      <child>arm_link</child>
    </joint>

    <joint name="arm_to_camera" type="fixed">
      <parent>arm_link</parent>
      <child>camera_link</child>
    </joint>

  </model>
</sdf>
