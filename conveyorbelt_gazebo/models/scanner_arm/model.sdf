<?xml version="1.0"?>
<!--
  Scanner arm model (SDF) for Gazebo Classic.
  - Vertical pole with horizontal extension.
  - Downward-facing camera sensor.
  - Static model.
-->
<sdf version="1.6">
  <model name="scanner_arm">
    <static>true</static>

    <link name="base_plate">
      <pose>0 0 0.01 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.55 0.57 0.60 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <albedo>0.55 0.57 0.60 1</albedo>
              <metalness>1.0</metalness>
              <roughness>0.2</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Decorative flange ring + bolts (visual only) -->
      <visual name="base_ring_visual">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      <visual name="bolt_1">
        <pose>0.06 0.06 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="bolt_2">
        <pose>-0.06 0.06 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="bolt_3">
        <pose>-0.06 -0.06 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="bolt_4">
        <pose>0.06 -0.06 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="pole_link">
      <pose>0 0 0.62 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.10</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.10</iyy>
          <iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <collision name="pole_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>1.20</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pole_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>1.20</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.55 0.57 0.60 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <albedo>0.55 0.57 0.60 1</albedo>
              <metalness>1.0</metalness>
              <roughness>0.2</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Simple collar and top cap (visual only) -->
      <visual name="pole_collar">
        <pose>0 0 -0.55 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      <visual name="pole_cap">
        <pose>0 0 0.60 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.032</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="arm_link">
      <pose>0.25 0 1.22 0 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.05</iyy>
          <iyz>0</iyz>
          <izz>0.05</izz>
        </inertia>
      </inertial>
      <collision name="arm_collision">
        <geometry>
          <box>
            <size>0.50 0.05 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="arm_visual">
        <geometry>
          <box>
            <size>0.50 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.55 0.57 0.60 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
          <pbr>
            <metal>
              <albedo>0.55 0.57 0.60 1</albedo>
              <metalness>1.0</metalness>
              <roughness>0.2</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Rounded end-caps + cable conduit (visual only) -->
      <visual name="arm_endcap_left">
        <pose>-0.25 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
        </material>
      </visual>
      <visual name="arm_endcap_right">
        <pose>0.25 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.25 0.26 0.28 1</diffuse>
        </material>
      </visual>
      <visual name="arm_conduit">
        <pose>0 0.032 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.45</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="camera_link">
      <pose>0.50 0 1.22 3 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.10 0.08 0.06</size>
          </box>
        </geometry>
      </collision>
      
      <!-- Industrial camera housing -->
      <visual name="camera_housing_main">
        <geometry>
          <box><size>0.10 0.08 0.06</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.2 0.2 0.24 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      
      <!-- Camera front face plate -->
      <visual name="camera_faceplate">
        <pose>0 0 -0.032 0 0 0</pose>
        <geometry>
          <box><size>0.095 0.075 0.005</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.1 1</ambient>
          <diffuse>0.1 0.1 0.12 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      
      <!-- Main camera lens housing -->
      <visual name="camera_lens_housing">
        <pose>0 0 -0.045 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.022</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
        </material>
      </visual>
      
      <!-- Glass lens element -->
      <visual name="camera_lens_glass">
        <pose>0 0 -0.062 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.018</radius><length>0.005</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.15 0.2 0.8</ambient>
          <diffuse>0.15 0.2 0.3 0.9</diffuse>
          <specular>0.95 0.95 0.95 1</specular>
        </material>
      </visual>
      
      <!-- IR illuminator ring -->
      <visual name="ir_ring">
        <pose>0 0 -0.036 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.032</radius><length>0.004</length></cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
        </material>
      </visual>
      
      <!-- Status LED - Power (green) -->
      <visual name="led_power">
        <pose>0.035 0.025 -0.031 0 0 0</pose>
        <geometry>
          <sphere><radius>0.004</radius></sphere>
        </geometry>
        <material>
          <ambient>0.1 0.8 0.2 1</ambient>
          <diffuse>0.15 0.9 0.3 1</diffuse>
          <emissive>0.05 0.4 0.1 1</emissive>
        </material>
      </visual>
      
      <!-- Status LED - Active (blue) -->
      <visual name="led_active">
        <pose>0.035 0.015 -0.031 0 0 0</pose>
        <geometry>
          <sphere><radius>0.004</radius></sphere>
        </geometry>
        <material>
          <ambient>0.2 0.4 0.9 1</ambient>
          <diffuse>0.3 0.5 0.95 1</diffuse>
          <emissive>0.1 0.2 0.5 1</emissive>
        </material>
      </visual>
      
      <!-- Mounting bracket -->
      <visual name="camera_bracket">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry>
          <box><size>0.06 0.04 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.4 0.42 0.45 1</ambient>
          <diffuse>0.5 0.52 0.55 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      
      <!-- Brand label area -->
      <visual name="camera_label">
        <pose>0.035 0 0.015 0 0 0</pose>
        <geometry>
          <box><size>0.025 0.05 0.025</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.92 1</ambient>
          <diffuse>0.95 0.95 0.97 1</diffuse>
        </material>
      </visual>
      
      <!-- Ventilation slots -->
      <visual name="vent_slot_1">
        <pose>-0.04 0.02 0 0 0 0</pose>
        <geometry><box><size>0.015 0.003 0.04</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="vent_slot_2">
        <pose>-0.04 0 0 0 0 0</pose>
        <geometry><box><size>0.015 0.003 0.04</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="vent_slot_3">
        <pose>-0.04 -0.02 0 0 0 0</pose>
        <geometry><box><size>0.015 0.003 0.04</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>

      <sensor name="scanner_camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
        <!-- Sensor pose (xyz rpy). Pitch -90deg to look down; roll set to 3 rad as requested. -->
        <pose>0 0 -0.025 3 -1.5708 0</pose>
        <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera</namespace>
          </ros>
          <cameraName>scanner_camera</cameraName>
          <imageTopicName>raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>camera_link</frameName>
          <updateRate>30.0</updateRate>
        </plugin>
      </sensor>
    </link>

    <joint name="base_to_pole" type="fixed">
      <parent>base_plate</parent>
      <child>pole_link</child>
    </joint>

    <joint name="pole_to_arm" type="fixed">
      <parent>pole_link</parent>
      <child>arm_link</child>
    </joint>

    <joint name="arm_to_camera" type="fixed">
      <parent>arm_link</parent>
      <child>camera_link</child>
    </joint>

  </model>
</sdf>
