<?xml version="1.0"?>
<sdf version="1.6">
  <model name="sorting_bin_expired">
    <static>true</static>

    <!-- Base/Bottom of the bin -->
    <link name="bin_base">
      <pose>0 0 0.005 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.05</iyy><iyz>0</iyz><izz>0.05</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box><size>0.35 0.25 0.01</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box><size>0.35 0.25 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.5 0.1 1</ambient>
          <diffuse>0.85 0.7 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- Front wall -->
    <link name="wall_front">
      <pose>0.17 0 0.10 0 0 0</pose>
      <collision name="front_collision">
        <geometry>
          <box><size>0.01 0.25 0.19</size></box>
        </geometry>
      </collision>
      <visual name="front_visual">
        <geometry>
          <box><size>0.01 0.25 0.19</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.5 0.1 1</ambient>
          <diffuse>0.85 0.7 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- Back wall -->
    <link name="wall_back">
      <pose>-0.17 0 0.10 0 0 0</pose>
      <collision name="back_collision">
        <geometry>
          <box><size>0.01 0.25 0.19</size></box>
        </geometry>
      </collision>
      <visual name="back_visual">
        <geometry>
          <box><size>0.01 0.25 0.19</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.5 0.1 1</ambient>
          <diffuse>0.85 0.7 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- Left wall -->
    <link name="wall_left">
      <pose>0 -0.12 0.10 0 0 0</pose>
      <collision name="left_collision">
        <geometry>
          <box><size>0.33 0.01 0.19</size></box>
        </geometry>
      </collision>
      <visual name="left_visual">
        <geometry>
          <box><size>0.33 0.01 0.19</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.5 0.1 1</ambient>
          <diffuse>0.85 0.7 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- Right wall -->
    <link name="wall_right">
      <pose>0 0.12 0.10 0 0 0</pose>
      <collision name="right_collision">
        <geometry>
          <box><size>0.33 0.01 0.19</size></box>
        </geometry>
      </collision>
      <visual name="right_visual">
        <geometry>
          <box><size>0.33 0.01 0.19</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.5 0.1 1</ambient>
          <diffuse>0.85 0.7 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- Label panel on front -->
    <link name="label_panel">
      <pose>0.176 0 0.16 0 0 0</pose>
      <visual name="label_visual">
        <geometry>
          <box><size>0.002 0.12 0.06</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- Yellow/amber warning indicator -->
    <link name="status_indicator">
      <pose>0.178 0 0.16 0 0 0</pose>
      <visual name="indicator_visual">
        <geometry>
          <box><size>0.001 0.04 0.04</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.0 1</ambient>
          <diffuse>1.0 0.8 0.0 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <emissive>0.4 0.3 0.0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- Hazard stripes on top edge -->
    <link name="hazard_stripe_front">
      <pose>0.17 0 0.195 0 0 0</pose>
      <visual name="stripe_visual">
        <geometry>
          <box><size>0.012 0.25 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- Corner reinforcements (industrial look) -->
    <link name="corner_1">
      <pose>0.165 0.115 0.10 0 0 0</pose>
      <visual name="corner1_visual">
        <geometry>
          <cylinder><radius>0.015</radius><length>0.19</length></cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.4 0.08 1</ambient>
          <diffuse>0.7 0.55 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <link name="corner_2">
      <pose>0.165 -0.115 0.10 0 0 0</pose>
      <visual name="corner2_visual">
        <geometry>
          <cylinder><radius>0.015</radius><length>0.19</length></cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.4 0.08 1</ambient>
          <diffuse>0.7 0.55 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <link name="corner_3">
      <pose>-0.165 0.115 0.10 0 0 0</pose>
      <visual name="corner3_visual">
        <geometry>
          <cylinder><radius>0.015</radius><length>0.19</length></cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.4 0.08 1</ambient>
          <diffuse>0.7 0.55 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <link name="corner_4">
      <pose>-0.165 -0.115 0.10 0 0 0</pose>
      <visual name="corner4_visual">
        <geometry>
          <cylinder><radius>0.015</radius><length>0.19</length></cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.4 0.08 1</ambient>
          <diffuse>0.7 0.55 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <!-- Fixed joints -->
    <joint name="base_to_front" type="fixed">
      <parent>bin_base</parent>
      <child>wall_front</child>
    </joint>
    <joint name="base_to_back" type="fixed">
      <parent>bin_base</parent>
      <child>wall_back</child>
    </joint>
    <joint name="base_to_left" type="fixed">
      <parent>bin_base</parent>
      <child>wall_left</child>
    </joint>
    <joint name="base_to_right" type="fixed">
      <parent>bin_base</parent>
      <child>wall_right</child>
    </joint>
    <joint name="front_to_label" type="fixed">
      <parent>wall_front</parent>
      <child>label_panel</child>
    </joint>
    <joint name="label_to_indicator" type="fixed">
      <parent>label_panel</parent>
      <child>status_indicator</child>
    </joint>
    <joint name="front_to_hazard" type="fixed">
      <parent>wall_front</parent>
      <child>hazard_stripe_front</child>
    </joint>
    <joint name="base_to_corner1" type="fixed">
      <parent>bin_base</parent>
      <child>corner_1</child>
    </joint>
    <joint name="base_to_corner2" type="fixed">
      <parent>bin_base</parent>
      <child>corner_2</child>
    </joint>
    <joint name="base_to_corner3" type="fixed">
      <parent>bin_base</parent>
      <child>corner_3</child>
    </joint>
    <joint name="base_to_corner4" type="fixed">
      <parent>bin_base</parent>
      <child>corner_4</child>
    </joint>

  </model>
</sdf>
