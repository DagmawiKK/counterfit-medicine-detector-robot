<?xml version="1.0"?>
<!--
  Sorting Robot Arm - 4-DOF Industrial Pick-and-Place Robot
  - Base rotation (joint_1): Rotates entire arm
  - Shoulder lift (joint_2): Raises/lowers upper arm
  - Elbow (joint_3): Extends/retracts forearm
  - Wrist rotation (joint_4): Rotates gripper
  - Gripper (left/right finger joints): Opens/closes to grasp objects
-->
<sdf version="1.6">
  <model name="sorting_robot_arm">
    <static>false</static>

    <!-- ==================== BASE PEDESTAL ==================== -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.15</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.15</iyy><iyz>0</iyz><izz>0.2</izz>
        </inertia>
      </inertial>
      <!-- Main base plate -->
      <collision name="base_collision">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <box><size>0.30 0.30 0.05</size></box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <box><size>0.30 0.30 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      <!-- Mounting bolts -->
      <visual name="bolt_fl">
        <pose>0.12 0.12 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="bolt_fr">
        <pose>0.12 -0.12 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="bolt_bl">
        <pose>-0.12 0.12 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="bolt_br">
        <pose>-0.12 -0.12 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
    </link>

    <!-- ==================== TURRET / ROTATING BASE ==================== -->
    <link name="turret_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <pose>0 0 0.06 0 0 0</pose>
        <inertia>
          <ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.03</iyy><iyz>0</iyz><izz>0.02</izz>
        </inertia>
      </inertial>
      <!-- Turret cylinder -->
      <collision name="turret_collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.08</radius><length>0.12</length></cylinder>
        </geometry>
      </collision>
      <visual name="turret_visual">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.08</radius><length>0.12</length></cylinder>
        </geometry>
        <material>
          <ambient>0.7 0.35 0.0 1</ambient>
          <diffuse>0.9 0.45 0.0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <!-- Top bearing cover -->
      <visual name="bearing_cover">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.09</radius><length>0.01</length></cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.65 0.67 0.70 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <!-- Cable conduit -->
      <visual name="cable_conduit">
        <pose>0.06 0 0.06 0 1.57 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="joint_1" type="revolute">
      <parent>base_link</parent>
      <child>turret_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>100</effort>
          <velocity>1.5</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== SHOULDER / UPPER ARM ==================== -->
    <link name="shoulder_link">
      <pose>0 0 0.175 0 0 0</pose>
      <inertial>
        <mass>3.5</mass>
        <pose>0 0 0.12 0 0 0</pose>
        <inertia>
          <ixx>0.025</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.025</iyy><iyz>0</iyz><izz>0.008</izz>
        </inertia>
      </inertial>
      <!-- Shoulder motor housing -->
      <visual name="shoulder_motor">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.05</radius><length>0.10</length></cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.65 0.67 0.70 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <!-- Upper arm segment -->
      <collision name="upper_arm_collision">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry>
          <box><size>0.06 0.08 0.24</size></box>
        </geometry>
      </collision>
      <visual name="upper_arm_visual">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry>
          <box><size>0.06 0.08 0.24</size></box>
        </geometry>
        <material>
          <ambient>0.7 0.35 0.0 1</ambient>
          <diffuse>0.9 0.45 0.0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <!-- Structural ribs -->
      <visual name="rib_1">
        <pose>0 0.042 0.08 0 0 0</pose>
        <geometry><box><size>0.062 0.004 0.06</size></box></geometry>
        <material><ambient>0.6 0.3 0.0 1</ambient><diffuse>0.75 0.38 0.0 1</diffuse></material>
      </visual>
      <visual name="rib_2">
        <pose>0 0.042 0.16 0 0 0</pose>
        <geometry><box><size>0.062 0.004 0.06</size></box></geometry>
        <material><ambient>0.6 0.3 0.0 1</ambient><diffuse>0.75 0.38 0.0 1</diffuse></material>
      </visual>
    </link>

    <joint name="joint_2" type="revolute">
      <parent>turret_link</parent>
      <child>shoulder_link</child>
      <pose>0 0 -0.05 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>80</effort>
          <velocity>1.2</velocity>
        </limit>
        <dynamics>
          <damping>0.4</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== ELBOW / FOREARM ==================== -->
    <link name="elbow_link">
      <pose>0 0 0.415 0 0 0</pose>
      <inertial>
        <mass>2.5</mass>
        <pose>0 0 0.10 0 0 0</pose>
        <inertia>
          <ixx>0.015</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.015</iyy><iyz>0</iyz><izz>0.005</izz>
        </inertia>
      </inertial>
      <!-- Elbow motor housing -->
      <visual name="elbow_motor">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.08</length></cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.65 0.67 0.70 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <!-- Forearm segment -->
      <collision name="forearm_collision">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box><size>0.05 0.06 0.20</size></box>
        </geometry>
      </collision>
      <visual name="forearm_visual">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box><size>0.05 0.06 0.20</size></box>
        </geometry>
        <material>
          <ambient>0.7 0.35 0.0 1</ambient>
          <diffuse>0.9 0.45 0.0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <!-- Cable harness -->
      <visual name="cable_harness">
        <pose>0 0.032 0.10 0 0 0</pose>
        <geometry>
          <box><size>0.02 0.008 0.18</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="joint_3" type="revolute">
      <parent>shoulder_link</parent>
      <child>elbow_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-2.35</lower>
          <upper>2.35</upper>
          <effort>60</effort>
          <velocity>1.5</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
          <friction>0.08</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== WRIST ==================== -->
    <link name="wrist_link">
      <pose>0 0 0.615 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <pose>0 0 0.03 0 0 0</pose>
        <inertia>
          <ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.003</iyy><iyz>0</iyz><izz>0.002</izz>
        </inertia>
      </inertial>
      <!-- Wrist rotation mechanism -->
      <collision name="wrist_collision">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.035</radius><length>0.06</length></cylinder>
        </geometry>
      </collision>
      <visual name="wrist_visual">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.035</radius><length>0.06</length></cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.65 0.67 0.70 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <!-- Bearing ring -->
      <visual name="wrist_ring">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.038</radius><length>0.005</length></cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
        </material>
      </visual>
    </link>

    <joint name="joint_4" type="revolute">
      <parent>elbow_link</parent>
      <child>wrist_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>30</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== GRIPPER BASE ==================== -->
    <link name="gripper_base">
      <pose>0 0 0.685 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <!-- Gripper mounting plate -->
      <collision name="gripper_base_collision">
        <geometry>
          <box><size>0.08 0.10 0.02</size></box>
        </geometry>
      </collision>
      <visual name="gripper_base_visual">
        <geometry>
          <box><size>0.08 0.10 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.28 1</ambient>
          <diffuse>0.35 0.35 0.38 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <!-- Pneumatic actuator (visual) -->
      <visual name="pneumatic_cylinder">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.012</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.7 0.72 0.75 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
    </link>

    <joint name="wrist_to_gripper" type="fixed">
      <parent>wrist_link</parent>
      <child>gripper_base</child>
      <pose>0 0 -0.02 0 0 0</pose>
    </joint>

    <!-- ==================== LEFT FINGER ==================== -->
    <link name="finger_left">
      <pose>0 0.035 0.72 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz><izz>0.00005</izz>
        </inertia>
      </inertial>
      <!-- Finger body -->
      <collision name="finger_left_collision">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry>
          <box><size>0.015 0.02 0.08</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="finger_left_visual">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry>
          <box><size>0.015 0.02 0.08</size></box>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.7 0.72 0.75 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <!-- Finger tip (rubber pad) -->
      <collision name="tip_left_collision">
        <pose>0 -0.005 0.075 0 0 0</pose>
        <geometry>
          <box><size>0.018 0.008 0.015</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="tip_left_visual">
        <pose>0 -0.005 0.075 0 0 0</pose>
        <geometry>
          <box><size>0.018 0.008 0.015</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="finger_left_joint" type="prismatic">
      <parent>gripper_base</parent>
      <child>finger_left</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.01</lower>
          <upper>0.025</upper>
          <effort>20</effort>
          <velocity>0.5</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.02</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== RIGHT FINGER ==================== -->
    <link name="finger_right">
      <pose>0 -0.035 0.72 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz><izz>0.00005</izz>
        </inertia>
      </inertial>
      <!-- Finger body -->
      <collision name="finger_right_collision">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry>
          <box><size>0.015 0.02 0.08</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="finger_right_visual">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry>
          <box><size>0.015 0.02 0.08</size></box>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.7 0.72 0.75 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <!-- Finger tip (rubber pad) -->
      <collision name="tip_right_collision">
        <pose>0 0.005 0.075 0 0 0</pose>
        <geometry>
          <box><size>0.018 0.008 0.015</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="tip_right_visual">
        <pose>0 0.005 0.075 0 0 0</pose>
        <geometry>
          <box><size>0.018 0.008 0.015</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="finger_right_joint" type="prismatic">
      <parent>gripper_base</parent>
      <child>finger_right</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-0.01</lower>
          <upper>0.025</upper>
          <effort>20</effort>
          <velocity>0.5</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.02</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== STATUS INDICATOR LIGHT ==================== -->
    <link name="status_light">
      <pose>0 0.06 0.175 0 0 0</pose>
      <visual name="light_housing">
        <geometry>
          <sphere><radius>0.015</radius></sphere>
        </geometry>
        <material>
          <ambient>0.0 0.8 0.0 1</ambient>
          <diffuse>0.0 1.0 0.0 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <emissive>0.0 0.4 0.0 1</emissive>
        </material>
      </visual>
    </link>

    <joint name="turret_to_light" type="fixed">
      <parent>turret_link</parent>
      <child>status_light</child>
    </joint>

    <!-- ==================== ROS2 JOINT CONTROL PLUGINS ==================== -->
    <!-- Joint state publisher -->
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/sorting_robot_arm</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>joint_1</joint_name>
      <joint_name>joint_2</joint_name>
      <joint_name>joint_3</joint_name>
      <joint_name>joint_4</joint_name>
      <joint_name>finger_left_joint</joint_name>
      <joint_name>finger_right_joint</joint_name>
    </plugin>

    <!-- Joint pose trajectory plugin - Kinematic control of joints -->
    <plugin name="joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros>
        <namespace>/sorting_robot_arm</namespace>
        <remapping>set_joint_trajectory:=set_joint_trajectory</remapping>
      </ros>
      <update_rate>50</update_rate>
    </plugin>

  </model>
</sdf>
