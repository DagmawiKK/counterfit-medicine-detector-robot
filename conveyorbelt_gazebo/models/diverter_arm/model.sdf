<?xml version="1.0"?>
<sdf version="1.6">
  <model name="diverter_arm">
    <static>false</static>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.01</iyy>
          <iyz>0.0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.08 0.08 0.02</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.08 0.08 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <link name="arm_link">
      <pose>0.06 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.002</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.002</iyy>
          <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="arm_collision">
        <geometry>
          <box>
            <size>0.12 0.02 0.02</size>
          </box>
        </geometry>
      </collision>
      <visual name="arm_visual">
        <geometry>
          <box>
            <size>0.12 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <joint name="diverter_joint" type="revolute">
      <parent>base_link</parent>
      <child>arm_link</child>
      <pose>0.04 0 0.04 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.2</lower>
          <upper>1.2</upper>
          <effort>5.0</effort>
          <velocity>2.0</velocity>
        </limit>
      </axis>
    </joint>
  </model>
</sdf>
