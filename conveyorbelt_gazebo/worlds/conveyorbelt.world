<sdf version="1.4">

  <world name="default">

    <!-- WORLD COMPONENTS: STANDARD -->

    <gravity>0 0 -9.8</gravity>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.45 0.47 0.50 1</ambient>
      <background>0.96 0.98 1.00 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- Indoor pharmacy-style lighting (environment only) -->
    <light name="pharmacy_overhead_fill" type="point">
      <pose>0 0 2.9 0 0 0</pose>
      <diffuse>0.95 0.98 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.6</constant>
        <linear>0.02</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>
    <light name="pharmacy_panel_1" type="point">
      <pose>-1.5 -1.5 2.9 0 0 0</pose>
      <diffuse>0.90 0.95 1.0 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.7</constant>
        <linear>0.03</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>
    <light name="pharmacy_panel_2" type="point">
      <pose>1.5 -1.5 2.9 0 0 0</pose>
      <diffuse>0.90 0.95 1.0 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.7</constant>
        <linear>0.03</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>
    <light name="pharmacy_panel_3" type="point">
      <pose>-1.5 1.5 2.9 0 0 0</pose>
      <diffuse>0.90 0.95 1.0 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.7</constant>
        <linear>0.03</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>
    <light name="pharmacy_panel_4" type="point">
      <pose>1.5 1.5 2.9 0 0 0</pose>
      <diffuse>0.90 0.95 1.0 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.7</constant>
        <linear>0.03</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>
    <light name="conveyor_spot" type="spot">
      <pose>0 0 2.8 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>0.5</inner_angle>
        <outer_angle>0.9</outer_angle>
        <falloff>0.8</falloff>
      </spot>
      <attenuation>
        <range>8</range>
        <constant>0.7</constant>
        <linear>0.02</linear>
        <quadratic>0.004</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Gazebo ROS plugins for ROS2 integration -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

    <!-- Insert Conveyor Belt -->
    <include>
      <name>conveyor_belt</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://conveyor_belt</uri>
    </include>

    <!-- Surrounding environment only (pharmacy-style room) -->
    <include>
      <name>pharmacy_environment</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://pharmacy_environment</uri>
    </include>

    <!-- Insert Scanner Arm (SDF model) centered above the belt -->
    <include>
      <name>scanner_arm</name>
      <pose>-0.5 0 0 0 0 0</pose>
      <uri>model://scanner_arm</uri>
    </include>

    <!-- ==================== SORTING ROBOT ARM ==================== -->
    <!-- 4-DOF robotic arm for pick-and-place medicine sorting -->
    <include>
      <name>sorting_robot_arm</name>
      <pose>0.5 -0.35 0.75 0 0 1.5708</pose>
      <uri>model://sorting_robot_arm</uri>
    </include>

    <!-- ==================== SORTING BINS ==================== -->
    <!-- Green bin for VALID medicine (status=0) -->
    <include>
      <name>bin_valid</name>
      <pose>0.85 0.30 0.75 0 0 0</pose>
      <uri>model://sorting_bin_valid</uri>
    </include>

    <!-- Yellow bin for EXPIRED medicine (status=1) -->
    <include>
      <name>bin_expired</name>
      <pose>0.85 0.0 0.75 0 0 0</pose>
      <uri>model://sorting_bin_expired</uri>
    </include>

    <!-- Red bin for COUNTERFEIT medicine (status=2) -->
    <include>
      <name>bin_counterfeit</name>
      <pose>0.85 -0.30 0.75 0 0 0</pose>
      <uri>model://sorting_bin_counterfeit</uri>
    </include>

    <!-- Bin Stand/Table for elevated bins -->
    <model name="bin_stand">
      <static>true</static>
      <pose>0.85 0.0 0.375 0 0 0</pose>
      <link name="stand_link">
        <collision name="stand_collision">
          <geometry>
            <box><size>0.50 0.90 0.75</size></box>
          </geometry>
        </collision>
        <visual name="stand_visual">
          <geometry>
            <box><size>0.50 0.90 0.75</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.62 1</ambient>
            <diffuse>0.75 0.75 0.78 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <!-- Industrial table legs -->
        <visual name="leg_fl">
          <pose>0.22 0.42 -0.30 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="leg_fr">
          <pose>0.22 -0.42 -0.30 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="leg_bl">
          <pose>-0.22 0.42 -0.30 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="leg_br">
          <pose>-0.22 -0.42 -0.30 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Robot Arm Pedestal -->
    <model name="robot_pedestal">
      <static>true</static>
      <pose>0.5 -0.35 0.375 0 0 0</pose>
      <link name="pedestal_link">
        <collision name="pedestal_collision">
          <geometry>
            <cylinder><radius>0.18</radius><length>0.75</length></cylinder>
          </geometry>
        </collision>
        <visual name="pedestal_visual">
          <geometry>
            <cylinder><radius>0.18</radius><length>0.75</length></cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.42 0.45 1</ambient>
            <diffuse>0.5 0.52 0.55 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <!-- Top mounting plate -->
        <visual name="mounting_plate">
          <pose>0 0 0.38 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.20</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>

</sdf>
